# Visual Testing Docker Image
# Matches CI environment (ubuntu-latest) for consistent screenshot rendering
#
# NOTE: Build happens on host machine due to Ember's high memory requirements.
# This container only runs tests against pre-built dist.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    locales \
    && rm -rf /var/lib/apt/lists/*

# Set up locale (important for consistent text rendering)
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install Node.js 22.x (for Playwright compatibility)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

# Install Yarn 1.x
RUN npm install -g yarn@1.21.1

# Install Playwright dependencies (Chromium)
RUN npx playwright install --with-deps chromium

WORKDIR /app

# Copy everything and install dependencies
COPY . .
RUN yarn --frozen-lockfile --ignore-engines

# Use ember test --server for incremental rebuilds with Broccoli caching
# First run is slow, subsequent rebuilds are fast
CMD ["yarn", "ember", "test", "--server"]
